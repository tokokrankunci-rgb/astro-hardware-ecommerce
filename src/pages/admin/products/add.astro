---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Tambah Produk Baru - Admin Dashboard">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">Tambah Produk Baru</h1>
        <p class="text-xs text-slate-500">Masukkan spesifikasi teknis produk hardware/sanitari & alokasi harga B2B.</p>
      </div>
      <a href="/admin/products" class="text-xs font-semibold text-slate-600 hover:text-slate-900 border border-slate-300 bg-white px-3 py-2 rounded-lg">
        &larr; Kembali ke Daftar Produk
      </a>
    </div>

    <form class="space-y-6" id="productForm">
      <!-- 1. Informasi Utama Produk -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2">1. Informasi Dasar</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Kode SKU Produk *</label>
            <input type="text" name="sku" required placeholder="Cth: LHR-9032-SS" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
          <div class="md:col-span-2">
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk *</label>
            <input type="text" name="name" required placeholder="Cth: Dekson Lever Handle Stainless Steel SUS 304" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori *</label>
            <select name="category_id" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
              <option value="">-- Pilih Kategori --</option>
              <option value="sanitary-ware">Sanitary Ware</option>
              <option value="sanitary-fitting">Sanitary Fitting</option>
              <option value="door-accessories">Door Accessories</option>
              <option value="glass-hardware">Glass & Aluminium Hardware</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Merek (Brand) *</label>
            <select name="brand_id" required class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
              <option value="">-- Pilih Merek --</option>
              <option value="dekson">Dekson</option>
              <option value="reallock">Reallock</option>
              <option value="arrone">Arrone</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Garansi Resmi</label>
            <input type="text" name="warranty" placeholder="Cth: 25 Tahun Garansi Mekanis" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
        </div>
      </div>

      <!-- 2. Harga, Berat Kargo, & Stok -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2">2. Harga, Stok & Parameter Kargo</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Harga Eceran B2C (Rp) *</label>
            <input type="number" name="price_retail" required placeholder="450000" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Berat Produk (Gram) *</label>
            <input type="number" name="weight_gram" required placeholder="1850" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            <span class="text-[10px] text-slate-400">Penting untuk perhitungan kargo (1.85 kg = 1850 gram).</span>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Jumlah Stok (Unit/Set) *</label>
            <input type="number" name="stock" required placeholder="100" class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
          </div>
        </div>

        <!-- Tier Pricing B2B (Grosir Bertingkat) -->
        <div class="mt-4 pt-3 border-t border-slate-100">
          <label class="block text-xs font-bold text-blue-900 mb-2">Skema Harga Grosir Proyek (B2B Tiered Price):</label>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 bg-blue-50/50 p-3 rounded-xl border border-blue-100 text-xs">
            <div>
              <span class="text-slate-500 block mb-1">Tier 1 (5 - 19 Set)</span>
              <input type="number" name="price_b2b_tier1" placeholder="Rp 360000" class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white text-xs" />
            </div>
            <div>
              <span class="text-slate-500 block mb-1">Tier 2 (20 - 49 Set)</span>
              <input type="number" name="price_b2b_tier2" placeholder="Rp 335000" class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white text-xs" />
            </div>
            <div>
              <span class="text-slate-500 block mb-1">Tier 3 (> 50 Set / Koli)</span>
              <input type="number" name="price_b2b_tier3" placeholder="Rp 310000" class="w-full px-2.5 py-1.5 border border-slate-300 rounded bg-white text-xs" />
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Spesifikasi Teknis & Gambar -->
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200 space-y-4">
        <h2 class="text-sm font-bold text-slate-800 border-b border-slate-100 pb-2">3. Deskripsi & Gambar</h2>
        
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Deskripsi Lengkap / Lembar Data Teknis</label>
          <textarea name="description" rows="3" placeholder="Masukkan detail peruntukan pintu, ketebalan, dan sertifikasi..." class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">URL Gambar Produk (High-Res / Blueprint)</label>
          <input type="url" name="image_url" placeholder="https://..." class="w-full px-3 py-2 border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-end gap-3">
        <button type="reset" class="px-5 py-2.5 bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold hover:bg-slate-300">
          Reset Form
        </button>
        <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white rounded-xl text-xs font-bold hover:bg-blue-700 shadow-lg shadow-blue-600/20">
          Simpan & Publikasikan Produk
        </button>
      </div>
    </form>
  </div>
</BaseLayout>