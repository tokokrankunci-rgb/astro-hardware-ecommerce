---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Toko Kran Kunci</title>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col">
    <!-- Header / Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-slate-900 flex items-center gap-2">
          <span class="bg-blue-600 text-white p-1.5 rounded-lg text-sm">🛠️</span>
          Toko Kran Kunci
        </a>
        <nav class="flex items-center gap-6">
          <a href="/" class="text-sm font-medium hover:text-blue-600 transition-colors">Beranda</a>
          <a href="/cart" class="text-sm font-medium hover:text-blue-600 transition-colors flex items-center gap-1">
            🛒 Keranjang
          </a>
        </nav>
      </div>
    </header>

    <!-- Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-6 border-t border-slate-800 mt-12">
      <div class="max-w-7xl mx-auto px-4 text-center text-xs">
        © 2026 Toko Kran Kunci. Distributor Resmi Hardware & Sanitary Ware.
      </div>
    </footer>
  </body>
</html>