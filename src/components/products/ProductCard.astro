---
import type { Product } from '../../types/ecommerce';

interface Props {
  product: Product;
  isB2B?: boolean;
}

const { product, isB2B = false } = Astro.props;
const displayPrice = isB2B ? product.price_b2b : product.price_retail;
---

<div class="bg-white rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow overflow-hidden flex flex-col justify-between">
  <a href={`/products/${product.slug}`} class="block relative group">
    <div class="aspect-square bg-slate-100 overflow-hidden">
      <img 
        src={product.image_url || '/images/placeholder.jpg'} 
        alt={product.name}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
    <div class="p-4">
      <span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded uppercase">
        {product.brand}
      </span>
      <h3 class="font-bold text-slate-900 text-sm mt-2 line-clamp-2 hover:text-blue-600">
        {product.name}
      </h3>
    </div>
  </a>

  <div class="p-4 pt-0 mt-auto">
    <div class="flex items-baseline justify-between mb-3">
      <div>
        <p class="text-xs text-slate-500">{isB2B ? 'Harga B2B' : 'Harga Eceran'}</p>
        <p class="text-lg font-extrabold text-slate-900">
          Rp {displayPrice.toLocaleString('id-ID')}
        </p>
      </div>
    </div>

    <a 
      href={`/products/${product.slug}`} 
      class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg text-xs transition-colors"
    >
      Lihat Detail
    </a>
  </div>
</div>