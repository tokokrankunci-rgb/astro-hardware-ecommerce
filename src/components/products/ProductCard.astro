---
import type { Product } from '../../types/ecommerce';

interface Props {
  product: Product;
  isB2B: boolean;
}

const { product, isB2B } = Astro.props;
---

<div class="bg-white rounded-xl border border-slate-200 p-4 flex flex-col justify-between hover:shadow-md transition">
  <div>
    <div class="aspect-square bg-slate-100 rounded-lg border border-slate-100 flex items-center justify-center relative mb-3">
      <span class="bg-slate-900 text-white text-[10px] px-2 py-0.5 rounded absolute top-2 left-2 font-semibold">SKU: {product.sku}</span>
      <span class="text-4xl">🚪</span>
    </div>
    <div class="flex items-center gap-1.5 mb-1">
      <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded">{product.brand}</span>
      <span class="text-[10px] text-emerald-600 font-semibold ml-auto">✓ Stock Ready</span>
    </div>
    <h3 class="font-bold text-sm text-slate-900 line-clamp-2 leading-snug">{product.name}</h3>
  </div>

  <div class="mt-4 pt-3 border-t border-slate-100">
    {isB2B ? (
      <div>
        <span class="text-[10px] text-slate-400 line-through block">Eceran: Rp {product.price_retail.toLocaleString('id-ID')}</span>
        <span class="text-base font-extrabold text-blue-700">Rp {product.price_b2b.toLocaleString('id-ID')}</span>
        <span class="text-[10px] bg-emerald-100 text-emerald-700 font-bold px-1.5 py-0.5 rounded ml-1">Diskon B2B</span>
      </div>
    ) : (
      <div>
        <span class="text-xs text-slate-500 block">Harga Eceran:</span>
        <span class="text-base font-extrabold text-slate-900">Rp {product.price_retail.toLocaleString('id-ID')}</span>
      </div>
    )}
    
    <a href={`/products/${product.slug}`} class="mt-3 w-full bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold py-2 rounded-lg text-center block transition">
      Lihat Detail & Specs
    </a>
  </div>
</div>