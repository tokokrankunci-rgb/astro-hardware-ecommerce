---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Ambil parameter slug dari URL (misal: dekson-lever-handle-sus304)
const { slug } = Astro.params;

// Cari data produk di Supabase yang kolom slug-nya cocok
const { data: product, error } = await supabase
  .from('products')
  .select('*')
  .eq('slug', slug)
  .single();

// Jika produk tidak ditemukan di database, tampilkan halaman 404
if (error || !product) {
  return Astro.redirect('/404');
}
---

<Layout title={product.name}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold">{product.name}</h1>
    <p class="text-gray-600 mt-2">SKU: {product.sku}</p>
    <div class="mt-4 text-2xl font-bold text-blue-600">
      Rp {product.price?.toLocaleString('id-ID')}
    </div>
    <p class="mt-4">{product.description}</p>
  </main>
</Layout>